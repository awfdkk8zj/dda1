local function printTableDetailed(tbl, indent, visited)
	indent = indent or 0
	visited = visited or {}

	if visited[tbl] then
		print(string.rep(" ", indent) .. "<cycle detected>")
		return
	end
	visited[tbl] = true

	for k, v in pairs(tbl) do
		local prefix = string.rep(" ", indent)
		local keyInfo = "[" .. tostring(k) .. "] (" .. typeof(k) .. ")"

		if typeof(v) == "table" then
			print(prefix .. keyInfo .. " = table {")
			printTableDetailed(v, indent + 2, visited)
			print(prefix .. "}")
		else
			print(prefix .. keyInfo .. " = " .. tostring(v) .. " (" .. typeof(v) .. ")")
		end
	end
end
