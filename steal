local function getindex(instance)
    for i, child in instance.Parent:GetChildren() do
        if child==instance then return i end
    end
end
local function PlotVecToGlobalVec(plotvec:Vector3)
    local vec1 = zone.Position + Vector3.new(plotvec.X*2.5,(plotvec.Y+0.4)*2.5,plotvec.Z*2.5)
    return vec1
end
local function normalizeVector3(v: Vector3, epsilon)
	epsilon = epsilon or 1e-3

	local function fix(n)
		local nearest = math.round(n)
		if math.abs(n - nearest) < epsilon then
			return nearest + (nearest < 0 and 0.1 or -0.1)
		end
		return n
	end

	return Vector3.new(
		fix(v.X),
		fix(v.Y),
		fix(v.Z)
	)
end
local function GlobalVecToPlotVec(globalvec: Vector3)
