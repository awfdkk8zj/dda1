local function clickGuiButton(button)
    print(button:GetFullName())
    -- Get the button's absolute position and size
    local absPos = button.AbsolutePosition
    local absSize = button.AbsoluteSize
    
    -- Get screen size
    local screenSize = workspace.CurrentCamera.ViewportSize
    
    -- Calculate the center of the button
    local centerX = absPos.X + (absSize.X / 2)
    local centerY = absPos.Y + (absSize.Y / 2)
    
    -- Check if button is on screen
    if absPos.X >= 0 and absPos.Y >= 0 and 
       (absPos.X + absSize.X) <= screenSize.X and 
       (absPos.Y + absSize.Y) <= screenSize.Y then
        
        -- Wait until Roblox is active
        repeat
            task.wait()
        until isrbxactive()

        -- Move mouse to the button's center position
        mousemoveabs(centerX + math.random(-10, 10), centerY + 50)
        
        -- Small delay to ensure mouse has moved
        task.wait()
        
        -- Click the button
        mouse1click()
        task.wait(0.2)
    else
        task.wait()
    end
end
