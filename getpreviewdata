local function cleanTable(tbl)
    local cleaned = {
        BlockSelected = {},
        BlockSelected2 = {}
    }

    -- Track seen IDs
    local seenBS = {}
    local seenBS2 = {}

    -- Remove duplicates inside BlockSelected
    for id, value in pairs(tbl.BlockSelected or {}) do
        if not seenBS[id] then
            seenBS[id] = true
            cleaned.BlockSelected[id] = value
        end
    end

    -- Remove duplicates inside BlockSelected2
    for id, value in pairs(tbl.BlockSelected2 or {}) do
        if not seenBS2[id] then
            seenBS2[id] = true
            cleaned.BlockSelected2[id] = value
        end
    end

    -- Remove entries from BlockSelected2 that exist in BlockSelected
    for id in pairs(cleaned.BlockSelected2) do
        if cleaned.BlockSelected[id] then
            cleaned.BlockSelected2[id] = nil
        end
    end

    return cleaned
end

local function updateGlobalStorage()
    local dr = cleanTable(capturedData)
    
