local function GetZone(player)
    local zone
    for _, zonei in workspace.BuildingZones:GetChildren() do
        if zonei.Owner.Value == player then zone = zonei end
    end
    return zone
end
local function getAircraftModelAtPosition(position)
    local aircraftFolder = workspace:WaitForChild("PIayerAircraft"):WaitForChild(game.Players.LocalPlayer.Name)

    for _, model in pairs(aircraftFolder:GetChildren()) do
        if model:IsA("Model") then
            local cf, size = model:GetBoundingBox()
            
            -- Early rejection: check if bounding box could possibly overlap
            local center = cf.Position
            local half = size * 0.5
            
            -- Quick AABB (axis-aligned bounding box) test with expanded radius
            local dx = math.abs(center.X - position.X)
            local dy = math.abs(center.Y - position.Y)
            local dz = math.abs(center.Z - position.Z)
            
            -- If center is too far, skip expensive corner checks
            if dx > half.X + 2.5 or dy > half.Y + 2.5 or dz > half.Z + 2.5 then
                continue
            end
            
            -- Only check corners if bounding box is close enough
            local offsets = {
                Vector3.new( half.X,  half.Y,  half.Z),
                Vector3.new( half.X,  half.Y, -half.Z),
                Vector3.new( half.X, -half.Y,  half.Z),
                Vector3.new( half.X, -half.Y, -half.Z),
                Vector3.new(-half.X,  half.Y,  half.Z),
                Vector3.new(-half.X,  half.Y, -half.Z),
                Vector3.new(-half.X, -half.Y,  half.Z),
                Vector3.new(-half.X, -half.Y, -half.Z),
            }

            for _, offset in ipairs(offsets) do
                local corner = cf:PointToWorldSpace(offset)
                
                if math.abs(corner.X - position.X) <= 2.5
                and math.abs(corner.Y - position.Y) <= 2.5
                and math.abs(corner.Z - position.Z) <= 2.5 then
                    return model
                end
            end
        end
    end

    return nil
end

local function checkblockfrompos(plotpos)
    return getAircraftModelAtPosition(PlotVecToGlobalVec(plotpos,GetZone(game.Players.LocalPlayer))) and true or false
end









local mouse = game:GetService("Players").LocalPlayer:GetMouse()
-- Global override
_G.mouseHitOverride = nil
-- Hook mouse metatable
local mousemt = getrawmetatable(mouse)
setreadonly(mousemt, false)
local oldIndex = mousemt.__index
mousemt.__index = newcclosure(function(self, key)
    if self == mouse and _G.mouseHitOverride then
        local obj = _G.mouseHitOverride
        -- Override mouse.Hit
        if key == "Hit" then
            if obj:IsA("Model") then
                local cf = obj:GetBoundingBox()
                return cf
            elseif obj:IsA("BasePart") then
                return obj.CFrame
            end
        end
        -- Override mouse.Target
        if key == "Target" then
            if obj:IsA("Model") then
                return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
            elseif obj:IsA("BasePart") then
                return obj
            end
        end
        -- Override mouse.TargetSurface
        if key == "TargetSurface" then
            return Enum.NormalId.Top
        end
    end
    
    return oldIndex(self, key)
end)
setreadonly(mousemt, true)
function _G.setMouseHitOverride(obj) _G.mouseHitOverride = obj end
